# npm run db:start membuat/memperbarui .env.local untuk Supabase Docker lokal.
# Untuk konfigurasi manual, salin berkas ini dan isi publishable key lokal.
CATALOG_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL publik tetap untuk QR saat deploy (contoh: https://nama-situs.vercel.app).
# Kosong saat lokal: QR mengikuti alamat localhost/IP jaringan pada browser admin.
SITE_URL=

# Untuk pratinjau tanpa backend, ubah CATALOG_MODE menjadi demo.
# Mode demo selalu menampilkan label data contoh dan tidak menulis ke database.
